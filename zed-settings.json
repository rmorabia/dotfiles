// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "tab_bar": {
    "show": false,
  },
  "autosave": "on_focus_change",
  "linked_edits": false,
  "edit_predictions": {
    "ollama": {
      "prompt_format": "qwen",
      "model": "hf.co/sweepai/sweep-next-edit-1.5B:latest",
    },
    "mode": "eager",
    "provider": "copilot",
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "acceptEdits",
        "model": "us.anthropic.claude-opus-4-6-v1",
      },
      "favorite_config_option_values": {
        "effort": ["medium"],
        "model": ["haiku"],
      },
      "type": "registry",
    },
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^npx\\s+jest(\\s|$)"
            },
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^echo\\b"
            },
            {
              "pattern": "^sed\\b"
            }
          ]
        },
      },
    },
    "sidebar_side": "right",
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "provider": "amazon-bedrock",
      "model": "claude-opus-5",
      "enable_thinking": true,
    },
    "commit_message_model": {
      "provider": "amazon-bedrock",
      "model": "claude-haiku-4-5",
    },
    "thread_summary_model": {
      "provider": "amazon-bedrock",
      "model": "claude-haiku-4-5",
    },
    "favorite_models": [
      {
        "provider": "amazon-bedrock",
        "model": "claude-opus-5",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "amazon-bedrock",
        "model": "claude-sonnet-5",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "single_file_review": true,
    "model_parameters": [],
  },
  "git": {
    "blame": {
      "show_avatar": false,
    },
  },
  "language_models": {
    "bedrock": {
      "authentication_method": "sso",
      "region": "us-west-2",
      "profile": "bedrock",
      "available_models": [
        {
          "name": "anthropic.claude-haiku-4-5-20251001-v1:0",
          "max_tokens": 200000,
        },
        {
          "name": "anthropic.claude-opus-4-6-v1",
          "max_tokens": 200000,
        },
      ],
    },
  },
  "title_bar": {
    "show_sign_in": false,
  },
  "prettier": {
    "allowed": true,
  },
  "colorize_brackets": true,
  "preferred_line_length": 120,
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "diff_view_style": "unified",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "icon_theme": "Zed (Default)",
  "base_keymap": "Cursor",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "light",
    "light": "Neovim default accented light",
    "dark": "Transparent Prism",
  },
  "terminal": {
    "shell": {
      "program": "/opt/homebrew/bin/fish",
    },
  },
  "semantic_tokens": "combined",
  "formatter": "prettier",
}
